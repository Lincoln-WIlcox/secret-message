  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: main.py with Arguments",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "args": ["${input:docUrl}"]
    },
    {
      "name": "Python Debugger: main.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "docUrl",
      "type": "promptString",
      "description": "Enter Google Doc URL",
      "default": "docs.google.com/document/d/e/2PACX-1vSvM5gDlNvt7npYHhp_XfsJvuntUhq184By5xO_pA4b_gCWeXb6dM6ZxwN8rE6S4ghUsCj2VKR21oEP/pub"
    }
  ]
}
